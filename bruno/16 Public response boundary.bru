tests {
  test("API exposes reference data, not connection credentials", () => { expect(res.status).to.equal(200); const raw=JSON.stringify(res.body); expect(raw).not.to.include("mongodb+srv://"); expect(raw).not.to.include("MONGODB_URI"); expect(raw).not.to.include("password"); });
}
